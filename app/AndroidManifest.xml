<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.crdroid.intelligence">

    <!--
      This package deliberately does NOT request android.permission.INTERNET.

      The SYSTEM_VENDOR_INTELLIGENCE and SYSTEM_UI_INTELLIGENCE roles - the ones that carry
      DISCOVER_APP_FUNCTIONS, and therefore access to the platform's AppFunctions registry -
      require their holder not to request INTERNET and to reach the network only through a
      separate open-source component. Model downloads therefore live in the companion package
      org.crdroid.intelligence.models. Adding INTERNET here silently forfeits the role.
    -->

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="org.crdroid.intelligence.permission.MANAGE_MODELS" />

    <!--
      Declared so the inference sandbox is allowed to reach a vendor NPU delegate where one
      exists. required="false" is mandatory: making it required would make the whole component
      unavailable across most of crDroid's device matrix.
    -->
    <uses-feature android:name="android.hardware.npu" android:required="false" />

    <!-- Runtime permission third-party apps request to reach OpenAICore's own task API. The
         platform's USE_ON_DEVICE_INTELLIGENCE is signature|privileged and is not obtainable by
         an ordinary app, so a ROM-level API for third parties has to be our own. -->
    <permission
        android:name="org.crdroid.intelligence.permission.USE_INTELLIGENCE"
        android:label="@string/permlab_use_intelligence"
        android:description="@string/permdesc_use_intelligence"
        android:permissionGroup="android.permission-group.UNDEFINED"
        android:protectionLevel="dangerous" />

    <application
        android:label="@string/app_name"
        android:icon="@drawable/ic_intelligence"
        android:defaultToDeviceProtectedStorage="true"
        android:directBootAware="true"
        android:allowBackup="false"
        android:supportsRtl="true">

        <!--
          Layer 2: the broker. system_server binds this and it is the only component that decides
          anything - features, consent, quota, tiering, and which file descriptors the sandbox
          gets. Content never passes through it.
        -->
        <service
            android:name=".broker.IntelligenceBrokerService"
            android:exported="true"
            android:directBootAware="true"
            android:permission="android.permission.BIND_ON_DEVICE_INTELLIGENCE_SERVICE">
            <intent-filter>
                <action android:name="android.service.ondeviceintelligence.OnDeviceIntelligenceService" />
            </intent-filter>
        </service>

        <!--
          Layer 1: the sandbox, and the only process that sees prompt or response text.

          isolatedProcess is not a choice: OnDeviceIntelligenceManagerService throws
          SecurityException at bind time unless FLAG_ISOLATED_PROCESS is set and
          FLAG_EXTERNAL_SERVICE is not. It buys an isolated uid with no network, no ability to
          open files by path, and the isolated_compute_app SELinux domain - which ActiveServices
          assigns automatically from this intent action, and which is what grants the GPU access
          ML Drift needs.
        -->
        <service
            android:name=".inference.InferenceService"
            android:exported="true"
            android:isolatedProcess="true"
            android:permission="android.permission.BIND_ON_DEVICE_SANDBOXED_INFERENCE_SERVICE">
            <intent-filter>
                <action android:name="android.service.ondeviceintelligence.OnDeviceSandboxedInferenceService" />
            </intent-filter>
        </service>

        <!-- Throwaway process for the backend probe: a GPU driver fault here costs a probe. -->
        <service
            android:name=".probe.BackendProbeService"
            android:exported="false"
            android:process=":probe" />

        <!-- OpenAICore's own task API for third-party apps. -->
        <service
            android:name=".api.OpenIntelligenceService"
            android:exported="true"
            android:permission="org.crdroid.intelligence.permission.USE_INTELLIGENCE">
            <intent-filter>
                <action android:name="org.crdroid.intelligence.OpenIntelligenceService" />
            </intent-filter>
        </service>

        <activity
            android:name=".settings.IntelligenceSettingsActivity"
            android:exported="true"
            android:label="@string/settings_title"
            android:theme="@style/Theme.OpenAICore">
            <intent-filter>
                <action android:name="org.crdroid.intelligence.action.SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

    </application>
</manifest>
