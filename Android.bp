package {
    default_applicable_licenses: ["packages_apps_OpenAICore_license"],
}

license {
    name: "packages_apps_OpenAICore_license",
    visibility: [":__subpackages__"],
    license_kinds: ["SPDX-license-identifier-Apache-2.0"],
    license_text: ["NOTICE"],
}

// -----------------------------------------------------------------------------
// Shared types and the provider AIDL, used by both APKs.
// -----------------------------------------------------------------------------
java_library {
    name: "openaicore-common",
    srcs: [
        "common/src/**/*.java",
        "common/aidl/**/*.aidl",
    ],
    aidl: {
        local_include_dirs: ["common/aidl"],
        export_include_dirs: ["common/aidl"],
    },
    // system_current, not module_current: android.app.ondeviceintelligence is a @SystemApi
    // surface. It is not reachable from the public SDK, which is also why the third-party API in
    // OpenIntelligenceService has to exist at all.
    sdk_version: "system_current",
    min_sdk_version: "34",
}

// -----------------------------------------------------------------------------
// Layer 4: the client SDK apps link against.
// -----------------------------------------------------------------------------
java_library {
    name: "openaicore-sdk",
    srcs: [
        "sdk/src/**/*.java",
        "sdk/aidl/**/*.aidl",
    ],
    aidl: {
        local_include_dirs: ["sdk/aidl"],
        export_include_dirs: ["sdk/aidl"],
    },
    // The SDK is for ordinary apps, so it must compile against the public API only. If a
    // @SystemApi symbol ever creeps in here, third-party callers stop being able to build.
    sdk_version: "current",
    min_sdk_version: "34",
    installable: false,
}

// -----------------------------------------------------------------------------
// Native: the probe helpers and the JNI bridge to the engine adapter.
// -----------------------------------------------------------------------------
cc_library_shared {
    name: "libopenaicore_jni",
    srcs: [
        "native/jni/engine_jni.cc",
        "native/jni/opencl_probe.cc",
    ],
    local_include_dirs: ["native/include"],
    header_libs: ["jni_headers"],
    shared_libs: [
        "libEGL",
        "libGLESv2",
        "liblog",
    ],
    // Deliberately no dependency on libOpenCL or on the engine adapter: both are dlopened.
    // Linking either would make this library fail to load on the majority of crDroid's device
    // matrix, taking the whole inference process with it instead of falling back.
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
    ],
    product_specific: true,
    compile_multilib: "64",
}

// -----------------------------------------------------------------------------
// The engine adapter is built out of tree and is NOT declared here.
//
// LiteRT-LM builds with Bazel and does not integrate with Soong. Build the adapter against a
// pinned LiteRT-LM tag as described in native/litertlm/README.md, drop the result into
// prebuilts/litertlm/<abi>/, and add prebuilts/litertlm/Android.bp (see Android.bp.sample there)
// to install it. Declaring the prebuilt unconditionally here would break every build that does
// not carry the binary.
//
// The JNI layer dlopens libopenaicore_litertlm.so by soname, so a build without it still boots;
// EngineHolder falls back to the model-free engine and every feature reports unavailable.
// -----------------------------------------------------------------------------

// -----------------------------------------------------------------------------
// APK 1: broker, inference sandbox, probe, third-party API, settings.
// No INTERNET permission - see app/AndroidManifest.xml for why that matters.
// -----------------------------------------------------------------------------
android_app {
    name: "OpenAICore",
    manifest: "app/AndroidManifest.xml",
    srcs: ["app/src/**/*.java"],
    resource_dirs: ["app/res"],
    static_libs: [
        "openaicore-common",
        "openaicore-sdk",
    ],
    jni_libs: ["libopenaicore_jni"],
    use_embedded_native_libs: false,
    // Platform-signed and privileged: USE_ON_DEVICE_INTELLIGENCE is signature|privileged, and
    // the intelligence roles are systemOnly.
    certificate: "platform",
    privileged: true,
    product_specific: true,
    sdk_version: "system_current",
    required: [
        "privapp-permissions-org.crdroid.intelligence.xml",
        "org.crdroid.intelligence.xml",
    ],
    optimize: {
        proguard_flags_files: ["proguard.flags"],
    },
}

// -----------------------------------------------------------------------------
// APK 2: the model downloader. The only component with network access.
// -----------------------------------------------------------------------------
android_app {
    name: "OpenAICoreModels",
    manifest: "modelservice/AndroidManifest.xml",
    srcs: ["modelservice/src/**/*.java"],
    resource_dirs: ["modelservice/res"],
    static_libs: ["openaicore-common"],
    certificate: "platform",
    privileged: true,
    product_specific: true,
    sdk_version: "system_current",
    optimize: {
        proguard_flags_files: ["proguard.flags"],
    },
}

prebuilt_etc {
    name: "privapp-permissions-org.crdroid.intelligence.xml",
    src: "etc/privapp-permissions-org.crdroid.intelligence.xml",
    sub_dir: "permissions",
    product_specific: true,
    filename_from_src: true,
}

prebuilt_etc {
    name: "org.crdroid.intelligence.xml",
    src: "etc/org.crdroid.intelligence.xml",
    sub_dir: "sysconfig",
    product_specific: true,
    filename_from_src: true,
}
