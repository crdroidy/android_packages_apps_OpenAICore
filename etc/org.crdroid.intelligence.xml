<config>
    <!--
      The intelligence roles require their holder not to bind arbitrary applications. The only
      cross-package bind OpenAICore performs is to its own model provider, declared explicitly
      here so the restriction can be enforced rather than assumed.
    -->
    <allow-association
        target="org.crdroid.intelligence"
        allowed="org.crdroid.intelligence.models" />
    <allow-association
        target="org.crdroid.intelligence.models"
        allowed="org.crdroid.intelligence" />

    <!-- Keep both halves out of app standby: the broker has to answer a feature query promptly,
         and a paused model provider means a stalled multi-gigabyte download. -->
    <allow-in-power-save package="org.crdroid.intelligence" />
    <allow-in-data-usage-save package="org.crdroid.intelligence.models" />
</config>
